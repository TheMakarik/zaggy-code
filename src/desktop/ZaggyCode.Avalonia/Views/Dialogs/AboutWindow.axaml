<Window
    Background="{DynamicResource BackgroundBrush}"
    BorderBrush="{DynamicResource ForegroundBrush}"
    BorderThickness="1"
    CanResize="False"
    Foreground="{DynamicResource ForegroundBrush}"
    Height="700"
    ShowInTaskbar="False"
    Title="О приложении"
    Width="330"
    WindowStartupLocation="CenterOwner"
    x:Class="ZaggyCode.Avalonia.Views.Dialogs.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">
        <controls:DialogTitleBar
            Grid.Row="0"
            Name="CustomTitleBar"
            Title="О приложении" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">

            <controls:SvgFromContent
                Height="120"
                HorizontalAlignment="Center"
                Loaded="LoadLogo"
                Margin="0,0,0,16"
                Width="120" />

            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Name="AppNameText" />

            <TextBlock
                FontSize="13"
                HorizontalAlignment="Center"
                Name="VersionText"
                Opacity="0.7" />

            <Separator Margin="24,14,24,14" />

            <TextBlock
                FontSize="14"
                HorizontalAlignment="Center"
                LineHeight="20"
                MaxWidth="270"
                Name="DescriptionText"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel HorizontalAlignment="Center" Margin="0,18,0,0" Spacing="4">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource ForegroundMutedBrush}"
                    HorizontalAlignment="Center"
                    Text="Разработчики:" />
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Name="DevelopersText"
                    TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

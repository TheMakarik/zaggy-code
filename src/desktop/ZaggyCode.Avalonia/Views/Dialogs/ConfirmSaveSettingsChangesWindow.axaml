<Window
    Background="{DynamicResource BackgroundBrush}"
    CanResize="False"
    Foreground="{DynamicResource ForegroundBrush}"
    Height="180"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Title="Сохранение изменений"
    Width="420"
    WindowStartupLocation="CenterOwner"
    x:Class="ZaggyCode.Avalonia.Views.Dialogs.ConfirmSaveSettingsChangesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Classes="header-bar"
            Grid.Row="0"
            Name="CustomTitleBar"
            Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="Сохранение изменений"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="icon-button window-control"
                        Click="MinimizeButton_Click"
                        ToolTip.Tip="Свернуть">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" />
                    </Button>
                    <Button
                        Classes="icon-button window-control close"
                        Click="CloseButton_Click"
                        ToolTip.Tip="Закрыть">
                        <materialIcons:MaterialIcon Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="20"
            RowDefinitions="*,Auto">
            <Grid ColumnDefinitions="Auto, *" Grid.Row="0">
                <controls:SvgFromContent
                    Grid.Column="0"
                    Height="80"
                    Loaded="LoadIcon"
                    Margin="8,0"
                    Width="80" />
                <TextBlock
                    FontSize="15"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Text="Вы дейстительно хотите сохранить изменения, совершенные в настройках?"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Click="YesButton_Click"
                    Content="Да"
                    IsDefault="True" />
                <Button
                    Click="NoButton_Click"
                    Content="Нет"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

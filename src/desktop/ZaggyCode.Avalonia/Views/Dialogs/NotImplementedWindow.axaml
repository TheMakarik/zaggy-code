<Window
    Background="{DynamicResource BackgroundBrush}"
    BorderBrush="{DynamicResource ForegroundBrush}"
    BorderThickness="1"
    CanResize="False"
    Foreground="{DynamicResource ForegroundBrush}"
    Height="220"
    ShowInTaskbar="False"
    SizeToContent="Width"
    Title="Функция временно недоступна"
    WindowStartupLocation="CenterOwner"
    x:Class="ZaggyCode.Avalonia.Views.Dialogs.NotImplementedWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">
        <Border
            Classes="header-bar"
            Grid.Row="0"
            Name="CustomTitleBar"
            Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    PointerPressed="TitleBar_PointerPressed"
                    Text="Функция временно недоступна"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="icon-button window-control"
                        Click="MinimizeButton_Click"
                        ToolTip.Tip="Свернуть">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" />
                    </Button>
                    <Button
                        Classes="icon-button window-control close"
                        Click="CloseButton_Click"
                        ToolTip.Tip="Закрыть">
                        <materialIcons:MaterialIcon Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,20" RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,*" Grid.Row="0">
            <controls:SvgFromContent
                Grid.Column="0"
                Height="96"
                Loaded="LoadZaggyIcon"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Width="96" />
            <StackPanel
                Grid.Column="1"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Упс!" />
                <TextBlock
                    LineHeight="20"
                    Opacity="0.85"
                    Text="Эта функция пока что не поддерживается"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Button
            Click="OkButton_Click"
            Content="ОК"
            Grid.Row="1"
            HorizontalAlignment="Right"
            IsDefault="True" />
        </Grid>
    </Grid>
</Window>

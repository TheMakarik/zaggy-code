<rxui:ReactiveWindow
    Background="{DynamicResource WindowBackgroundBrush}"
    CanResize="True"
    Foreground="{DynamicResource TextPrimaryBrush}"
    Name="ThisWindow"
    Title="Программирование с Загги"
    WindowDecorations="{Binding UseOsDecoration, Converter={converters:BoolToWindowDecorationsConverter}}"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    x:Class="ZaggyCode.Avalonia.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    x:TypeArguments="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:behaviors="clr-namespace:ZaggyCode.Avalonia.Views.Behaviors"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters.Common"
    xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataEnums="clr-namespace:ZaggyCode.Core.Data.Enums;assembly=ZaggyCode.Core"
    xmlns:enums="clr-namespace:ZaggyCode.Core.GamesCore.Enums;assembly=ZaggyCode.Core"
    xmlns:languageRuntime="clr-namespace:ZaggyCode.Core.LanguageRuntime.Enums;assembly=ZaggyCode.Core"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:Markdown.Avalonia.Full;assembly=Markdown.Avalonia.Full"
    xmlns:records="clr-namespace:ZaggyCode.Avalonia.ViewModels.Common.Records"
    xmlns:rxui="http://reactiveui.net"
    xmlns:userControls="clr-namespace:ZaggyCode.Avalonia.Views.UserControls"
    xmlns:vm="using:ZaggyCode.Avalonia.ViewModels.Main"
    xmlns:vt="using:VirtualTerminal"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <rxui:ReactiveWindow.KeyBindings>
        <KeyBinding Command="{Binding RunSelectedCodeCommand}" Gesture="Ctrl+Alt+R" />
    </rxui:ReactiveWindow.KeyBindings>

    <Grid
        Classes="main-background"
        ColumnDefinitions="6,*,6"
        RowDefinitions="6,Auto,Auto,*,Auto,Auto,6">
        <Border
            Background="Transparent"
            Cursor="TopLeftCorner"
            Grid.Column="0"
            Grid.Row="0"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="TopLeft" />
        <Border
            Background="Transparent"
            Cursor="TopSide"
            Grid.Column="1"
            Grid.Row="0"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="Top" />
        <Border
            Background="Transparent"
            Cursor="TopRightCorner"
            Grid.Column="2"
            Grid.Row="0"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="TopRight" />
        <Border
            Background="Transparent"
            Cursor="LeftSide"
            Grid.Column="0"
            Grid.Row="1"
            Grid.RowSpan="5"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="Left" />
        <Border
            Background="Transparent"
            Cursor="RightSide"
            Grid.Column="2"
            Grid.Row="1"
            Grid.RowSpan="5"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="Right" />
        <Border
            Background="Transparent"
            Cursor="BottomLeftCorner"
            Grid.Column="0"
            Grid.Row="6"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="BottomLeft" />
        <Border
            Background="Transparent"
            Cursor="BottomSide"
            Grid.Column="1"
            Grid.Row="6"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="Bottom" />
        <Border
            Background="Transparent"
            Cursor="BottomRightCorner"
            Grid.Column="2"
            Grid.Row="6"
            PointerPressed="ResizeHandle_PointerPressed"
            Tag="BottomRight" />

        <!--  Горизонтальная боковая панель (сверху или снизу)  -->
        <Border
            Classes="sidebar"
            Grid.Column="1"
            Grid.Row="{Binding SidebarRow}"
            IsVisible="{Binding IsHorizontalSidebarVisible}"
            Padding="7,5">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button
                    Classes="icon-button run-button"
                    Command="{Binding ExecuteCodeCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=Play}"
                    ToolTip.Tip="Запустить Загги" />
                <Button
                    Classes="icon-button"
                    Content="{materialIcons:MaterialIconExt Kind=ViewListOutline}"
                    ToolTip.Tip="Открыть загруженные уровни" />
                <Button
                    Classes="icon-button"
                    Command="{Binding ThrowNotImplementedCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=Download}"
                    ToolTip.Tip="Установить уровень из интернета" />
                <Button
                    Classes="icon-button"
                    Content="{materialIcons:MaterialIconExt Kind=FileDownload}"
                    ToolTip.Tip="Установить уровень из файла" />
                <Button
                    Classes="icon-button"
                    Content="{materialIcons:MaterialIconExt Kind=ContentSave}"
                    ToolTip.Tip="Сохранить" />
                <Button Classes="icon-button" ToolTip.Tip="Скорость">
                    <TextBlock HorizontalAlignment="Center" Text="{Binding ExecutionSpeed}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <Border
                                Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}"
                                Padding="4">
                                <ItemsControl ItemsSource="{Binding Source={x:Type languageRuntime:ExecutionSpeed}, Converter={converters:EnumValuesConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button
                                                Classes="speed-flyout-button"
                                                Command="{Binding DataContext.ChangeExecutionSpeedCommand, ElementName=ThisWindow}"
                                                CommandParameter="{Binding .}"
                                                Content="{Binding .}"
                                                Margin="5,0">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                        <Binding Path="." />
                                                        <Binding ElementName="ThisWindow" Path="DataContext.ExecutionSpeed" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Classes="icon-button"
                    Command="{Binding OpenAboutCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=HelpBox}"
                    ToolTip.Tip="Справка по приложению" />
                <Button
                    Classes="icon-button"
                    Command="{Binding OpenSettingsCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=Settings}"
                    ToolTip.Tip="Настройки" />
                <Button
                    Classes="icon-button"
                    Command="{Binding ChangeTerminalVisibilityCommand}"
                    Content="{materialIcons:MaterialIconExt Kind=Terminal}"
                    ToolTip.Tip="Терминал" />
            </StackPanel>
        </Border>

        <!--  Шапка  -->
        <Border
            BorderThickness="0"
            Classes="header-bar"
            Grid.Column="1"
            Grid.Row="1"
            Name="HeaderBar"
            Padding="9,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">

                    <Menu Classes="full-menu" IsVisible="{Binding #ThisWindow.Bounds.Width, Converter={converters:WidthToVisibilityConverter}, ConverterParameter='&gt;=900'}">
                        <MenuItem Header="Уровни" Icon="{materialIcons:MaterialIconExt Kind=Games}">
                            <MenuItem Header="Открыть уровень из файловой системы" Icon="{materialIcons:MaterialIconExt Kind=Games}" />
                            <MenuItem Header="Создать уровень" Icon="{materialIcons:MaterialIconExt Kind=Create}" />
                            <MenuItem
                                Command="{Binding ThrowNotImplementedCommand}"
                                Header="Загрузить уровень из репозитория"
                                Icon="{materialIcons:MaterialIconExt Kind=Download}" />
                            <MenuItem
                                Header="Скорость"
                                Icon="{materialIcons:MaterialIconExt Kind=Speedometer}"
                                ItemsSource="{Binding Source={x:Type languageRuntime:ExecutionSpeed}, Converter={converters:EnumValuesConverter}}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme
                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                        TargetType="MenuItem"
                                        x:DataType="languageRuntime:ExecutionSpeed">
                                        <Setter Property="Header" Value="{Binding ., Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding DataContext.ChangeExecutionSpeedCommand, ElementName=ThisWindow}" />
                                        <Setter Property="CommandParameter" Value="{Binding .}" />
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="Файл" Icon="{materialIcons:MaterialIconExt Kind=File}">
                            <MenuItem Header="Сохранить" Icon="{materialIcons:MaterialIconExt Kind=ContentSave}" />
                            <MenuItem
                                Click="EditorCut_Click"
                                Header="Вырезать выделенное"
                                Icon="{materialIcons:MaterialIconExt Kind=ContentCut}"
                                InputGesture="Ctrl+X" />
                            <MenuItem
                                Click="EditorCopy_Click"
                                Header="Копировать выделенное"
                                Icon="{materialIcons:MaterialIconExt Kind=ContentCopy}"
                                InputGesture="Ctrl+C" />
                            <MenuItem
                                Click="EditorPaste_Click"
                                Header="Вставить"
                                Icon="{materialIcons:MaterialIconExt Kind=ContentPaste}"
                                InputGesture="Ctrl+V" />
                            <MenuItem
                                Click="EditorDeleteSelection_Click"
                                Header="Удалить выделенное"
                                Icon="{materialIcons:MaterialIconExt Kind=TrashCan}"
                                Name="DeleteSelectionMenuItem" />
                            <MenuItem
                                Command="{Binding RunSelectedCodeCommand}"
                                Header="Запустить выделенное"
                                Icon="{materialIcons:MaterialIconExt Kind=PlayArrow}"
                                InputGesture="Ctrl+Alt+R" />
                        </MenuItem>

                        <MenuItem Header="Вид" Icon="{materialIcons:MaterialIconExt Kind=Eye}">
                            <MenuItem
                                Header="Тема подсветки синтаксиса"
                                Icon="{materialIcons:MaterialIconExt Kind=CodeBlockBraces}"
                                ItemsSource="{Binding AvailableCodeThemes}"
                                Name="CodeThemeMenu">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme
                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                        TargetType="MenuItem"
                                        x:DataType="records:CodeThemeItem">
                                        <Setter Property="Header" Value="{Binding .}" />
                                        <Setter Property="Command" Value="{Binding DataContext.SelectCodeThemeCommand, ElementName=ThisWindow}" />
                                        <Setter Property="CommandParameter" Value="{Binding ThemeName}" />
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate x:DataType="records:CodeThemeItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <materialIcons:MaterialIcon
                                                            Height="17"
                                                            Kind="{Binding IconName, Converter={converters:IconNameToKindConverter}}"
                                                            VerticalAlignment="Center"
                                                            Width="17" />
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="IsEnabled">
                                            <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                <Binding Path="ThemeName" />
                                                <Binding ElementName="ThisWindow" Path="DataContext.CodeTheme" />
                                            </MultiBinding>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>
                            <MenuItem
                                Header="Положение боковой панели"
                                Icon="{materialIcons:MaterialIconExt Kind=PageLayoutSidebarLeft}"
                                ItemsSource="{Binding Source={x:Type dataEnums:SidebarPosition}, Converter={converters:EnumValuesConverter}}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme
                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                        TargetType="MenuItem"
                                        x:DataType="x:String">
                                        <Setter Property="Header" Value="{Binding .}" />
                                        <Setter Property="Command" Value="{Binding DataContext.ChangeSidebarPositionCommand, ElementName=ThisWindow}" />
                                        <Setter Property="CommandParameter" Value="{Binding .}" />
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate x:DataType="x:String">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <materialIcons:MaterialIcon
                                                            Height="17"
                                                            Kind="{Binding ., Converter={converters:SidebarPositionToIconConverter}}"
                                                            VerticalAlignment="Center"
                                                            Width="17" />
                                                        <TextBlock Text="{Binding ., Converter={converters:SidebarPositionToTextConverter}}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="IsEnabled">
                                            <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                <Binding Path="." />
                                                <Binding ElementName="ThisWindow" Path="DataContext.SidebarPosition" />
                                            </MultiBinding>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding DataContext.ToggleUseSystemTitleBarCommand, ElementName=ThisWindow}"
                                Header="Использовать системную рамку окна"
                                Icon="{materialIcons:MaterialIconExt Kind=WindowMaximize}"
                                IsChecked="{Binding DataContext.UseOsDecoration, ElementName=ThisWindow}"
                                Theme="{StaticResource ZaggyToggleMenuItem}" />
                            <MenuItem
                                Command="{Binding DataContext.ChangeTerminalVisibilityCommand, ElementName=ThisWindow}"
                                Header="Терминал"
                                Icon="{materialIcons:MaterialIconExt Kind=Terminal}"
                                IsChecked="{Binding DataContext.IsTerminalVisible, ElementName=ThisWindow}"
                                Theme="{StaticResource ZaggyToggleMenuItem}" />
                            <MenuItem Header="Текст" Icon="{materialIcons:MaterialIconExt Kind=FontSize}">
                                <MenuItem
                                    Command="{Binding IncrementEditorFontSizeCommand}"
                                    Header="Увеличить размер текста редактора и описания"
                                    Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeIncrease}" />
                                <MenuItem
                                    Command="{Binding DecrementEditorFontSizeCommand}"
                                    Header="Уменьшить размер текста редактора и описания"
                                    Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeDecrease}" />
                                <MenuItem
                                    Command="{Binding IncrementTerminalFontSizeCommand}"
                                    Header="Увеличить размер текста терминала"
                                    Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeIncrease}" />
                                <MenuItem
                                    Command="{Binding DecrementTerminalFontSizeCommand}"
                                    Header="Уменьшить размер текста терминала"
                                    Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeDecrease}" />
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="Сервис" Icon="{materialIcons:MaterialIconExt Kind=Settings}">
                            <MenuItem
                                Command="{Binding OpenSettingsCommand}"
                                Header="Настройки"
                                Icon="{materialIcons:MaterialIconExt Kind=Settings}" />
                            <MenuItem
                                Command="{Binding ThrowNotImplementedCommand}"
                                Header="Управление горячими клавишами"
                                Icon="{materialIcons:MaterialIconExt Kind=KeyboardSettings}" />
                            <MenuItem Header="Python" Icon="{materialIcons:MaterialIconExt Kind=LanguagePython}">
                                <MenuItem
                                    Header="Подавлять ввод и вывод"
                                    Icon="{materialIcons:MaterialIconExt Kind=ConsoleLine}"
                                    IsChecked="{Binding DataContext.PythonSettings.SupressIo, ElementName=ThisWindow, Mode=TwoWay}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                                <MenuItem
                                    Header="Использовать явную точку входа"
                                    Icon="{materialIcons:MaterialIconExt Kind=Console}"
                                    IsChecked="{Binding DataContext.PythonSettings.UseEntryFunction, ElementName=ThisWindow, Mode=TwoWay}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                            </MenuItem>
                            <MenuItem Header="C#" Icon="{materialIcons:MaterialIconExt Kind=LanguageCsharp}">
                                <MenuItem
                                    Header="Использовать операторы верхнего уровня"
                                    Icon="{materialIcons:MaterialIconExt Kind=FormatListNumbered}"
                                    IsChecked="{Binding DataContext.CSharpSettings.UseTopLevelStatements, ElementName=ThisWindow, Mode=TwoWay}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                                <MenuItem
                                    Header="Использовать неявные using"
                                    Icon="{materialIcons:MaterialIconExt Kind=Import}"
                                    IsChecked="{Binding DataContext.CSharpSettings.EnableImplicitUsings, ElementName=ThisWindow, Mode=TwoWay}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                                <MenuItem
                                    Header="Подавлять ввод и вывод"
                                    Icon="{materialIcons:MaterialIconExt Kind=ConsoleLine}"
                                    IsChecked="{Binding DataContext.CSharpSettings.BlockIo, ElementName=ThisWindow, Mode=TwoWay}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="Справка" Icon="{materialIcons:MaterialIconExt Kind=HelpBox}">
                            <MenuItem
                                Command="{Binding OpenAboutCommand}"
                                Header="О приложении"
                                Icon="{materialIcons:MaterialIconExt Kind=About}" />
                            <MenuItem Header="Руководство по программированию" Icon="{materialIcons:MaterialIconExt Kind=Code}">
                                <MenuItem Header="C# (Си Шарп)" Icon="{materialIcons:MaterialIconExt Kind=LanguageCsharp}" />
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <Menu
                        Classes="compact-menu"
                        IsVisible="{Binding #ThisWindow.Bounds.Width, Converter={converters:WidthToVisibilityConverter}, ConverterParameter='&lt;900'}"
                        ToolTip.Tip="Меню">
                        <MenuItem Background="Transparent" Padding="9">
                            <MenuItem.Header>
                                <materialIcons:MaterialIcon
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Height="23"
                                    Kind="Menu"
                                    Width="23" />
                            </MenuItem.Header>

                            <MenuItem Header="Уровни" Icon="{materialIcons:MaterialIconExt Kind=Games}">
                                <MenuItem Header="Открыть уровень из файловой системы" Icon="{materialIcons:MaterialIconExt Kind=Games}" />
                                <MenuItem Header="Создать уровень" Icon="{materialIcons:MaterialIconExt Kind=Create}" />
                                <MenuItem
                                    Command="{Binding ThrowNotImplementedCommand}"
                                    Header="Загрузить уровень из репозитория"
                                    Icon="{materialIcons:MaterialIconExt Kind=Download}" />
                                <MenuItem
                                    Header="Скорость"
                                    Icon="{materialIcons:MaterialIconExt Kind=Speedometer}"
                                    ItemsSource="{Binding Source={x:Type languageRuntime:ExecutionSpeed}, Converter={converters:EnumValuesConverter}}">
                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme
                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                            TargetType="MenuItem"
                                            x:DataType="languageRuntime:ExecutionSpeed">
                                            <Setter Property="Header" Value="{Binding ., Mode=OneWay}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeExecutionSpeedCommand, ElementName=ThisWindow}" />
                                            <Setter Property="CommandParameter" Value="{Binding .}" />
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>
                                </MenuItem>
                            </MenuItem>

                            <MenuItem Header="Файл" Icon="{materialIcons:MaterialIconExt Kind=File}">
                                <MenuItem Header="Сохранить" Icon="{materialIcons:MaterialIconExt Kind=ContentSave}" />
                                <MenuItem
                                    Click="EditorCut_Click"
                                    Header="Вырезать выделенное"
                                    Icon="{materialIcons:MaterialIconExt Kind=ContentCut}"
                                    InputGesture="Ctrl+X" />
                                <MenuItem
                                    Click="EditorCopy_Click"
                                    Header="Копировать выделенное"
                                    Icon="{materialIcons:MaterialIconExt Kind=ContentCopy}"
                                    InputGesture="Ctrl+C" />
                                <MenuItem
                                    Click="EditorPaste_Click"
                                    Header="Вставить"
                                    Icon="{materialIcons:MaterialIconExt Kind=ContentPaste}"
                                    InputGesture="Ctrl+V" />
                                <MenuItem
                                    Click="EditorDeleteSelection_Click"
                                    Header="Удалить выделенное"
                                    Icon="{materialIcons:MaterialIconExt Kind=TrashCan}"
                                    Name="CompactDeleteSelectionMenuItem" />
                                <MenuItem
                                    Command="{Binding RunSelectedCodeCommand}"
                                    Header="Запустить выделенное"
                                    Icon="{materialIcons:MaterialIconExt Kind=PlayArrow}"
                                    InputGesture="Ctrl+Alt+R" />
                            </MenuItem>

                            <MenuItem Header="Вид" Icon="{materialIcons:MaterialIconExt Kind=Eye}">
                                <MenuItem
                                    Header="Тема подсветки синтаксиса"
                                    Icon="{materialIcons:MaterialIconExt Kind=CodeBlockBraces}"
                                    ItemsSource="{Binding AvailableCodeThemes}">
                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme
                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                            TargetType="MenuItem"
                                            x:DataType="records:CodeThemeItem">
                                            <Setter Property="Header" Value="{Binding .}" />
                                            <Setter Property="Command" Value="{Binding DataContext.SelectCodeThemeCommand, ElementName=ThisWindow}" />
                                            <Setter Property="CommandParameter" Value="{Binding ThemeName}" />
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate x:DataType="records:CodeThemeItem">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <materialIcons:MaterialIcon
                                                                Height="17"
                                                                Kind="{Binding IconName, Converter={converters:IconNameToKindConverter}}"
                                                                VerticalAlignment="Center"
                                                                Width="17" />
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsEnabled">
                                                <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                    <Binding Path="ThemeName" />
                                                    <Binding ElementName="ThisWindow" Path="DataContext.CodeTheme" />
                                                </MultiBinding>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                <MenuItem
                                    Header="Положение боковой панели"
                                    Icon="{materialIcons:MaterialIconExt Kind=PageLayoutSidebarLeft}"
                                    ItemsSource="{Binding Source={x:Type dataEnums:SidebarPosition}, Converter={converters:EnumValuesConverter}}">
                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme
                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                            TargetType="MenuItem"
                                            x:DataType="x:String">
                                            <Setter Property="Header" Value="{Binding .}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ChangeSidebarPositionCommand, ElementName=ThisWindow}" />
                                            <Setter Property="CommandParameter" Value="{Binding .}" />
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate x:DataType="x:String">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <materialIcons:MaterialIcon
                                                                Height="17"
                                                                Kind="{Binding ., Converter={converters:SidebarPositionToIconConverter}}"
                                                                VerticalAlignment="Center"
                                                                Width="17" />
                                                            <TextBlock Text="{Binding ., Converter={converters:SidebarPositionToTextConverter}}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsEnabled">
                                                <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                    <Binding Path="." />
                                                    <Binding ElementName="ThisWindow" Path="DataContext.SidebarPosition" />
                                                </MultiBinding>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding DataContext.ToggleUseSystemTitleBarCommand, ElementName=ThisWindow}"
                                    Header="Использовать системную рамку окна"
                                    Icon="{materialIcons:MaterialIconExt Kind=WindowMaximize}"
                                    IsChecked="{Binding DataContext.UseOsDecoration, ElementName=ThisWindow}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                                <MenuItem
                                    Command="{Binding DataContext.ChangeTerminalVisibilityCommand, ElementName=ThisWindow}"
                                    Header="Терминал"
                                    Icon="{materialIcons:MaterialIconExt Kind=Terminal}"
                                    IsChecked="{Binding DataContext.IsTerminalVisible, ElementName=ThisWindow}"
                                    Theme="{StaticResource ZaggyToggleMenuItem}" />
                                <MenuItem Header="Текст" Icon="{materialIcons:MaterialIconExt Kind=FontSize}">
                                    <MenuItem
                                        Command="{Binding IncrementEditorFontSizeCommand}"
                                        Header="Увеличить размер текста редактора и описания"
                                        Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeIncrease}" />
                                    <MenuItem
                                        Command="{Binding DecrementEditorFontSizeCommand}"
                                        Header="Уменьшить размер текста редактора и описания"
                                        Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeDecrease}" />
                                    <MenuItem
                                        Command="{Binding IncrementTerminalFontSizeCommand}"
                                        Header="Увеличить размер текста терминала"
                                        Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeIncrease}" />
                                    <MenuItem
                                        Command="{Binding DecrementTerminalFontSizeCommand}"
                                        Header="Уменьшить размер текста терминала"
                                        Icon="{materialIcons:MaterialIconExt Kind=FormatFontSizeDecrease}" />
                                </MenuItem>
                            </MenuItem>

                            <MenuItem Header="Сервис" Icon="{materialIcons:MaterialIconExt Kind=Settings}">
                                <MenuItem
                                    Command="{Binding OpenSettingsCommand}"
                                    Header="Настройки"
                                    Icon="{materialIcons:MaterialIconExt Kind=Settings}" />
                                <MenuItem
                                    Command="{Binding ThrowNotImplementedCommand}"
                                    Header="Управление горячими клавишами"
                                    Icon="{materialIcons:MaterialIconExt Kind=KeyboardSettings}" />
                                <MenuItem Header="Python" Icon="{materialIcons:MaterialIconExt Kind=LanguagePython}">
                                    <MenuItem
                                        Header="Подавлять ввод и вывод"
                                        Icon="{materialIcons:MaterialIconExt Kind=ConsoleLine}"
                                        IsChecked="{Binding DataContext.PythonSettings.SupressIo, ElementName=ThisWindow, Mode=TwoWay}"
                                        Theme="{StaticResource ZaggyToggleMenuItem}" />
                                    <MenuItem
                                        Header="Использовать явную точку входа"
                                        Icon="{materialIcons:MaterialIconExt Kind=Console}"
                                        IsChecked="{Binding DataContext.PythonSettings.UseEntryFunction, ElementName=ThisWindow, Mode=TwoWay}"
                                        Theme="{StaticResource ZaggyToggleMenuItem}" />
                                </MenuItem>
                                <MenuItem Header="C#" Icon="{materialIcons:MaterialIconExt Kind=LanguageCsharp}">
                                    <MenuItem
                                        Header="Использовать операторы верхнего уровня"
                                        Icon="{materialIcons:MaterialIconExt Kind=FormatListNumbered}"
                                        IsChecked="{Binding DataContext.CSharpSettings.UseTopLevelStatements, ElementName=ThisWindow, Mode=TwoWay}"
                                        Theme="{StaticResource ZaggyToggleMenuItem}" />
                                    <MenuItem
                                        Header="Использовать неявные using"
                                        Icon="{materialIcons:MaterialIconExt Kind=Import}"
                                        IsChecked="{Binding DataContext.CSharpSettings.EnableImplicitUsings, ElementName=ThisWindow, Mode=TwoWay}"
                                        Theme="{StaticResource ZaggyToggleMenuItem}" />
                                    <MenuItem
                                        Header="Подавлять ввод и вывод"
                                        Icon="{materialIcons:MaterialIconExt Kind=ConsoleLine}"
                                        IsChecked="{Binding DataContext.CSharpSettings.BlockIo, ElementName=ThisWindow, Mode=TwoWay}"
                                        Theme="{StaticResource ZaggyToggleMenuItem}" />
                                </MenuItem>
                            </MenuItem>

                            <MenuItem Header="Справка" Icon="{materialIcons:MaterialIconExt Kind=HelpBox}">
                                <MenuItem
                                    Command="{Binding OpenAboutCommand}"
                                    Header="О приложении"
                                    Icon="{materialIcons:MaterialIconExt Kind=About}" />
                                <MenuItem Header="Руководство по программированию" Icon="{materialIcons:MaterialIconExt Kind=Code}">
                                    <MenuItem Header="C# (Си Шарп)" Icon="{materialIcons:MaterialIconExt Kind=LanguageCsharp}" />
                                </MenuItem>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <ComboBox
                        Classes="language-selector"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding SelectedLanguageItem}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="records:LanguageItem">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <materialIcons:MaterialIcon
                                        Height="15"
                                        Kind="{Binding Value, Converter={converters:LanguageToIconConverter}}"
                                        Width="15" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    IsVisible="{Binding UseOsDecoration, Converter={converters:InverseBooleanConverter}}"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
                    <Button
                        Classes="icon-button window-control"
                        Name="MinimizeButton"
                        ToolTip.Tip="Свернуть">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" />
                    </Button>
                    <Button
                        Classes="icon-button window-control"
                        Name="MaximizeButton"
                        ToolTip.Tip="Развернуть">
                        <materialIcons:MaterialIcon Kind="WindowMaximize" Name="MaximizeIcon" />
                    </Button>
                    <Button
                        Classes="icon-button window-control close"
                        Name="CloseButton"
                        ToolTip.Tip="Закрыть">
                        <materialIcons:MaterialIcon Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Рабочая область  -->
        <Grid
            Classes="main-background"
            ColumnDefinitions="Auto,*,Auto"
            Grid.Column="1"
            Grid.Row="3">

            <Border
                Classes="sidebar"
                Grid.Column="{Binding SidebarColumn}"
                IsVisible="{Binding IsVerticalSidebarVisible}"
                Padding="5"
                Width="47">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel
                        Grid.Row="0"
                        Orientation="Vertical"
                        Spacing="3">
                        <Button
                            Classes="icon-button run-button"
                            Command="{Binding ExecuteCodeCommand}"
                            Content="{materialIcons:MaterialIconExt Kind=Play}"
                            ToolTip.Tip="Запустить Загги" />
                        <Button
                            Classes="icon-button"
                            Content="{materialIcons:MaterialIconExt Kind=ViewListOutline}"
                            ToolTip.Tip="Открыть загруженные уровни" />
                        <Button
                            Classes="icon-button"
                            Command="{Binding ThrowNotImplementedCommand}"
                            Content="{materialIcons:MaterialIconExt Kind=Download}"
                            ToolTip.Tip="Установить уровень из интернета" />
                        <Button
                            Classes="icon-button"
                            Content="{materialIcons:MaterialIconExt Kind=FileDownload}"
                            ToolTip.Tip="Установить уровень из файла" />
                        <Button
                            Classes="icon-button"
                            Content="{materialIcons:MaterialIconExt Kind=ContentSave}"
                            ToolTip.Tip="Сохранить" />
                        <Button Classes="icon-button" ToolTip.Tip="Скорость">
                            <TextBlock HorizontalAlignment="Center" Text="{Binding ExecutionSpeed}" />
                            <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                    <Border
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        CornerRadius="{DynamicResource SmallCornerRadius}"
                                        Padding="4">
                                        <ItemsControl ItemsSource="{Binding Source={x:Type languageRuntime:ExecutionSpeed}, Converter={converters:EnumValuesConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button
                                                        Classes="speed-flyout-button"
                                                        Command="{Binding DataContext.ChangeExecutionSpeedCommand, ElementName=ThisWindow}"
                                                        CommandParameter="{Binding .}"
                                                        Content="{Binding .}"
                                                        Margin="5,0">
                                                        <Button.IsEnabled>
                                                            <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                                                <Binding Path="." />
                                                                <Binding ElementName="ThisWindow" Path="DataContext.ExecutionSpeed" />
                                                            </MultiBinding>
                                                        </Button.IsEnabled>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Vertical"
                        Spacing="3">
                        <Button
                            Classes="icon-button"
                            Command="{Binding OpenAboutCommand}"
                            Content="{materialIcons:MaterialIconExt Kind=HelpBox}"
                            ToolTip.Tip="Справка по приложению" />
                        <Button
                            Classes="icon-button"
                            Command="{Binding OpenSettingsCommand}"
                            Content="{materialIcons:MaterialIconExt Kind=Settings}"
                            ToolTip.Tip="Настройки" />
                        <Button
                            Classes="icon-button"
                            Command="{Binding ChangeTerminalVisibilityCommand}"
                            Content="{materialIcons:MaterialIconExt Kind=Terminal}"
                            ToolTip.Tip="Терминал" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Содержимое  -->
            <Grid
                Grid.Column="1"
                Name="MainContentGrid"
                RowDefinitions="Auto,1.3*,Auto,0.7*">

                <Grid Grid.Row="1" Name="GameAndCodeGrid">
                    <Grid ColumnDefinitions="1.15*,Auto,0.85*">
                        <Grid Grid.Column="0">
                            <Border
                                Classes="card"
                                IsVisible="{Binding IsCodeVisible}"
                                Margin="12,12,6,12">
                                <avaloniaEdit:TextEditor
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    FontSize="{Binding TextEditorFontSize}"
                                    Foreground="{DynamicResource EditorForegroundBrush}"
                                    LineNumbersForeground="{DynamicResource EditorLineNumberBrush}"
                                    Name="Editor"
                                    ShowLineNumbers="True">
                                    <Interaction.Behaviors>
                                        <behaviors:TextEditorZoomBehavior
                                            MaxFontSize="{Binding MaxFontSize, Mode=OneTime}"
                                            MinFontSize="{Binding MinFontSize, Mode=OneTime}"
                                            UpdateFontSizeCommand="{Binding UpdateFontSizeCommand}"
                                            ZoomStep="1" />
                                    </Interaction.Behaviors>
                                    <avaloniaEdit:TextEditor.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="EditorCut_Click"
                                                Header="Вырезать"
                                                Icon="{materialIcons:MaterialIconExt Kind=ContentCut}"
                                                InputGesture="Ctrl+X" />
                                            <MenuItem
                                                Click="EditorCopy_Click"
                                                Header="Копировать"
                                                Icon="{materialIcons:MaterialIconExt Kind=ContentCopy}"
                                                InputGesture="Ctrl+C" />
                                            <MenuItem
                                                Click="EditorPaste_Click"
                                                Header="Вставить"
                                                Icon="{materialIcons:MaterialIconExt Kind=ContentPaste}"
                                                InputGesture="Ctrl+V" />
                                            <Separator />
                                            <MenuItem
                                                Command="{Binding RunSelectedCodeCommand}"
                                                Header="Запустить выделенное"
                                                Icon="{materialIcons:MaterialIconExt Kind=PlayArrow}"
                                                InputGesture="Ctrl+Alt+R" />
                                            <MenuItem
                                                Click="EditorDeleteSelection_Click"
                                                Header="Удалить выделенное"
                                                Icon="{materialIcons:MaterialIconExt Kind=TrashCan}"
                                                Name="EditorDeleteContextMenuItem" />
                                        </ContextMenu>
                                    </avaloniaEdit:TextEditor.ContextMenu>
                                </avaloniaEdit:TextEditor>
                            </Border>

                            <Border
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                IsVisible="{Binding IsDescriptionVisible}"
                                Margin="12,12,6,12"
                                Padding="16">
                                <md:MarkdownScrollViewer
                                    Focusable="True"
                                    Markdown="{Binding CurrentRobotGame.Description}">
                                    <Interaction.Behaviors>
                                        <behaviors:MarkdownZoomBehavior
                                            DefaultFontSize="14"
                                            FontSize="{Binding TextEditorFontSize}"
                                            MaxFontSize="{Binding MaxFontSize, Mode=OneTime}"
                                            MinFontSize="{Binding MinFontSize, Mode=OneTime}"
                                            UpdateFontSizeCommand="{Binding UpdateFontSizeCommand}"
                                            ZoomStep="1" />
                                    </Interaction.Behaviors>
                                    <md:MarkdownScrollViewer.Styles>
                                        <Style Selector="ctxt|CCode">
                                            <Setter Property="MonospaceFontFamily" Value="Noto Sans Mono,DejaVu Sans Mono,Liberation Mono,Cascadia Code,Consolas,Menlo,Monaco,Monospace" />
                                        </Style>
                                        <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
                                            <Setter Property="FontFamily" Value="Noto Sans Mono,DejaVu Sans Mono,Liberation Mono,Cascadia Code,Consolas,Menlo,Monaco,Monospace" />
                                        </Style>
                                    </md:MarkdownScrollViewer.Styles>
                                </md:MarkdownScrollViewer>
                            </Border>
                        </Grid>

                        <GridSplitter Classes="subtle" Grid.Column="1" />

                        <Border
                            Classes="card"
                            Grid.Column="2"
                            Margin="6,12,12,12">
                            <userControls:GameControl Margin="8" x:Name="GameMapView" />
                        </Border>
                    </Grid>
                </Grid>

                <GridSplitter Classes="horizontal" Grid.Row="2" />

                <Border
                    BorderThickness="1"
                    Classes="card"
                    Grid.Row="3"
                    IsVisible="{Binding IsTerminalVisible}"
                    Margin="12,0,12,12"
                    MinHeight="120">
                    <Grid RowDefinitions="Auto,*">
                        <Border
                            Classes="terminal-header"
                            Grid.Row="0"
                            Padding="8,3">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon
                                        Foreground="{DynamicResource AccentBrush}"
                                        Height="14"
                                        Kind="Terminal"
                                        Width="14" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="Терминал"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        Classes="window-control"
                                        Command="{Binding ChangeTerminalVisibilityCommand}"
                                        Padding="4"
                                        ToolTip.Tip="Свернуть терминал">
                                        <materialIcons:MaterialIcon
                                            Height="12"
                                            Kind="Minus"
                                            Width="12" />
                                    </Button>
                                    <Button
                                        Classes="window-control close"
                                        Command="{Binding CloseTheTerminalCommand}"
                                        Padding="4"
                                        ToolTip.Tip="Закрыть терминал">
                                        <materialIcons:MaterialIcon
                                            Height="12"
                                            Kind="Close"
                                            Width="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <vt:TerminalControl
                            Background="{DynamicResource TerminalBackgroundBrush}"
                            Focusable="True"
                            Foreground="{DynamicResource TerminalForegroundBrush}"
                            Grid.Row="1"
                            Margin="8,0"
                            MinHeight="100"
                            Padding="0,10,0,0"
                            TerminalFontFamily="Cascadia Code"
                            TerminalFontSize="{Binding TerminalFontSize}"
                            x:Name="Terminal">
                            <Interaction.Behaviors>
                                <behaviors:TerminalZoomBehavior
                                    DefaultFontSize="{Binding TerminalFontSize, Mode=OneTime}"
                                    MaxFontSize="{Binding MaxFontSize, Mode=OneTime}"
                                    MinFontSize="{Binding MinFontSize, Mode=OneTime}"
                                    UpdateFontSizeCommand="{Binding UpdateTerminalFontSizeCommand}"
                                    ZoomStep="1" />
                            </Interaction.Behaviors>
                        </vt:TerminalControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Нижняя строка состояния  -->
        <Border
            BorderThickness="0"
            Classes="footer-bar"
            Grid.Column="1"
            Grid.Row="5"
            Padding="10,3">
            <TextBlock
                FontSize="12"
                Name="FooterText"
                VerticalAlignment="Center" />
        </Border>

        <controls:SettingsToast
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Grid.Row="0"
            Grid.RowSpan="7"
            Name="SettingsToast"
            ZIndex="100" />
    </Grid>
</rxui:ReactiveWindow>

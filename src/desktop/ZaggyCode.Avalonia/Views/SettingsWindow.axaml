<rxui:ReactiveWindow
    Background="{DynamicResource BackgroundBrush}"
    CanResize="True"
    Foreground="{DynamicResource ForegroundBrush}"
    Height="600"
    MinHeight="500"
    MinWidth="700"
    Name="SettingsRoot"
    Title="Настройки"
    Width="850"
    WindowDecorations="{Binding AppearanceSettings.UseSystemTitleBar, Converter={converters:BoolToWindowDecorationsConverter}}"
    WindowStartupLocation="CenterOwner"
    x:Class="ZaggyCode.Avalonia.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    x:TypeArguments="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:vm="using:ZaggyCode.Avalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ZaggyCode.Avalonia.Views.UserControls">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Grid>
        <Grid ColumnDefinitions="6,*,6" RowDefinitions="6,*,6">
            <Border
                Background="Transparent"
                Cursor="TopLeftCorner"
                Grid.Column="0"
                Grid.Row="0"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="TopLeft" />
            <Border
                Background="Transparent"
                Cursor="TopSide"
                Grid.Column="1"
                Grid.Row="0"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="Top" />
            <Border
                Background="Transparent"
                Cursor="TopRightCorner"
                Grid.Column="2"
                Grid.Row="0"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="TopRight" />
            <Border
                Background="Transparent"
                Cursor="LeftSide"
                Grid.Column="0"
                Grid.Row="1"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="Left" />
            <Border
                Background="Transparent"
                Cursor="RightSide"
                Grid.Column="2"
                Grid.Row="1"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="Right" />
            <Border
                Background="Transparent"
                Cursor="BottomLeftCorner"
                Grid.Column="0"
                Grid.Row="2"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="BottomLeft" />
            <Border
                Background="Transparent"
                Cursor="BottomSide"
                Grid.Column="1"
                Grid.Row="2"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="Bottom" />
            <Border
                Background="Transparent"
                Cursor="BottomRightCorner"
                Grid.Column="2"
                Grid.Row="2"
                PointerPressed="ResizeHandle_PointerPressed"
                Tag="BottomRight" />

            <Grid
                Grid.Column="1"
                Grid.Row="1"
                RowDefinitions="Auto,*,Auto">
                <Border
                    Classes="header-bar"
                    Grid.Row="0"
                    IsVisible="{Binding AppearanceSettings.UseSystemTitleBar, Converter={converters:InverseBooleanConverter}}"
                    Name="HeaderBar"
                    Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            IsVisible="{Binding AppearanceSettings.UseSystemTitleBar, Converter={converters:InverseBooleanConverter}}"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <Button
                                Classes="icon-button window-control"
                                Name="MinimizeButton"
                                ToolTip.Tip="Свернуть">
                                <materialIcons:MaterialIcon Kind="WindowMinimize" />
                            </Button>
                            <Button
                                Classes="icon-button window-control"
                                Name="MaximizeButton"
                                ToolTip.Tip="Развернуть">
                                <materialIcons:MaterialIcon Kind="WindowMaximize" Name="MaximizeIcon" />
                            </Button>
                            <Button
                                Classes="icon-button window-control close"
                                Name="CloseButton"
                                ToolTip.Tip="Закрыть">
                                <materialIcons:MaterialIcon Kind="WindowClose" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl
                    Classes="settings-tab-control"
                    Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    TabStripPlacement="Left">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Eye" />
                                <TextBlock Text="Вид" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:AppearanceSettingsView DataContext="{Binding AppearanceSettings}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="LanguagePython" />
                                <TextBlock Text="Python" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:PythonSettingsView DataContext="{Binding PythonSettings}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="LanguageCsharp" />
                                <TextBlock Text="C#" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:CSharpSettingsView DataContext="{Binding CSharpSettings}" />
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2" Padding="20,12">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Classes="settings-footer-button"
                            Command="{Binding ResetToDefaultsCommand}"
                            Content="Сбросить все" />
                        <Button
                            Classes="settings-footer-button"
                            Command="{Binding CancelSettingsCommand}"
                            Content="Отмена" />
                        <Button
                            Classes="settings-footer-button primary"
                            Command="{Binding SaveSettingsCommand}"
                            Content="Сохранить"
                            IsEnabled="{Binding HasChangesAndPythonSettingsValid}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</rxui:ReactiveWindow>

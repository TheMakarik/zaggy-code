<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#1A1A1A</Color>
    <Color x:Key="BackgroundSecondaryColor">#242424</Color>
    <Color x:Key="SurfaceColor">#2E2E2E</Color>
    <Color x:Key="SurfaceLightColor">#383838</Color>
    <Color x:Key="SurfaceHoverColor">#444444</Color>

    <Color x:Key="PrimaryColor">#8A9A7A</Color>
    <Color x:Key="PrimaryLightColor">#A8BC9A</Color>
    <Color x:Key="PrimaryDarkColor">#6A7A5A</Color>

    <Color x:Key="SystemAccentColor">#8A9A7A</Color>
    <Color x:Key="SystemAccentColorLight1">#A8BC9A</Color>
    <Color x:Key="SystemAccentColorDark1">#6A7A5A</Color>

    <Color x:Key="ForegroundColor">#F0F0F0</Color>
    <Color x:Key="ForegroundMutedColor">#A8A8A8</Color>
    <Color x:Key="ForegroundDarkColor">#707070</Color>

    <Color x:Key="BorderColor">#3D3D3D</Color>
    <Color x:Key="BorderLightColor">#505050</Color>

    <Color x:Key="SuccessColor">#6ABA6A</Color>
    <Color x:Key="SuccessDarkColor">#4AA84A</Color>
    <Color x:Key="ErrorColor">#D87060</Color>
    <Color x:Key="WarningColor">#E8B840</Color>

    <Color x:Key="EditorBackgroundColor">#161616</Color>
    <Color x:Key="EditorForegroundColor">#F0F0F0</Color>
    <Color x:Key="EditorLineNumberColor">#707070</Color>

    <Color x:Key="TerminalBackgroundColor">#1A1A1A</Color>
    <Color x:Key="TerminalForegroundColor">#F0F0F0</Color>

    <Color x:Key="SidebarBackgroundColor">#242424</Color>

    <Color x:Key="MapWallColor">#8A8F96</Color>
    <Color x:Key="MapPointBorderColor">#F0F0F0</Color>
    <Color x:Key="MapPointBackgroundColor">#383838</Color>

    <SolidColorBrush Color="{DynamicResource BackgroundColor}" x:Key="BackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource BackgroundSecondaryColor}" x:Key="BackgroundSecondaryBrush" />
    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="SurfaceBrush" />
    <SolidColorBrush Color="{DynamicResource SurfaceLightColor}" x:Key="SurfaceLightBrush" />
    <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" x:Key="SurfaceHoverBrush" />

    <SolidColorBrush Color="{DynamicResource PrimaryColor}" x:Key="PrimaryBrush" />
    <SolidColorBrush Color="{DynamicResource PrimaryLightColor}" x:Key="PrimaryLightBrush" />
    <SolidColorBrush Color="{DynamicResource PrimaryDarkColor}" x:Key="PrimaryDarkBrush" />

    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" x:Key="SystemAccentBrush" />
    <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}" x:Key="SystemAccentColorLight1Brush" />
    <SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}" x:Key="SystemAccentColorDark1Brush" />

    <SolidColorBrush Color="{DynamicResource ForegroundColor}" x:Key="ForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource ForegroundMutedColor}" x:Key="ForegroundMutedBrush" />
    <SolidColorBrush Color="{DynamicResource ForegroundDarkColor}" x:Key="ForegroundDarkBrush" />

    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="BorderBrush" />
    <SolidColorBrush Color="{DynamicResource BorderLightColor}" x:Key="BorderLightBrush" />

    <SolidColorBrush Color="{DynamicResource SuccessColor}" x:Key="SuccessBrush" />
    <SolidColorBrush Color="{DynamicResource SuccessDarkColor}" x:Key="SuccessDarkBrush" />
    <SolidColorBrush Color="{DynamicResource ErrorColor}" x:Key="ErrorBrush" />
    <SolidColorBrush Color="{DynamicResource WarningColor}" x:Key="WarningBrush" />

    <SolidColorBrush Color="{DynamicResource EditorBackgroundColor}" x:Key="EditorBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource EditorForegroundColor}" x:Key="EditorForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource EditorLineNumberColor}" x:Key="EditorLineNumberBrush" />

    <SolidColorBrush Color="{DynamicResource TerminalBackgroundColor}" x:Key="TerminalBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource TerminalForegroundColor}" x:Key="TerminalForegroundBrush" />

    <SolidColorBrush Color="{DynamicResource SidebarBackgroundColor}" x:Key="SidebarBackgroundBrush" />

    <SolidColorBrush Color="{DynamicResource MapWallColor}" x:Key="MapWallBrush" />
    <SolidColorBrush Color="{DynamicResource MapPointBorderColor}" x:Key="MapPointBorderBrush" />
    <SolidColorBrush Color="{DynamicResource MapPointBackgroundColor}" x:Key="MapPointBackgroundBrush" />

    <!--  Переопределение дефолтов FluentTheme для выпадающих списков и всплывающих меню,
          иначе они игнорируют тему приложения (чёрный фон попапов, серое выделение)  -->
    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="MenuFlyoutPresenterBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="MenuFlyoutPresenterBorderBrush" />

    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="FlyoutPresenterBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="FlyoutPresenterBorderBrush" />

    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="ComboBoxDropDownBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="ComboBoxDropDownBorderBrush" />

    <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" x:Key="ComboBoxItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource PrimaryDarkColor}" x:Key="ComboBoxItemBackgroundSelected" />
    <SolidColorBrush Color="{DynamicResource PrimaryLightColor}" x:Key="ComboBoxItemBackgroundSelectedPointerOver" />
    <SolidColorBrush Color="{DynamicResource PrimaryDarkColor}" x:Key="ComboBoxItemBackgroundSelectedPressed" />
    <SolidColorBrush Color="{DynamicResource ForegroundColor}" x:Key="ComboBoxItemForegroundSelected" />

</ResourceDictionary>

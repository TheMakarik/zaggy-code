<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Фоны  -->
    <Color x:Key="WindowBackgroundColor">#1A1A1A</Color>
    <Color x:Key="HeaderBackgroundColor">#242424</Color>
    <Color x:Key="CardBackgroundColor">#2E2E2E</Color>
    <Color x:Key="ElevatedBackgroundColor">#383838</Color>
    <Color x:Key="HoverBackgroundColor">#444444</Color>
    <Color x:Key="SidebarBackgroundColor">#242424</Color>

    <!--  Акцент  -->
    <Color x:Key="AccentColor">#8A9A7A</Color>
    <Color x:Key="AccentHoverColor">#A8BC9A</Color>
    <Color x:Key="AccentPressedColor">#6A7A5A</Color>
    <Color x:Key="SystemAccentColor">#8A9A7A</Color>

    <!--  Текст  -->
    <Color x:Key="TextPrimaryColor">#F0F0F0</Color>
    <Color x:Key="TextMutedColor">#A8A8A8</Color>
    <Color x:Key="TextSubtleColor">#707070</Color>

    <!--  Рамки  -->
    <Color x:Key="BorderColor">#3D3D3D</Color>
    <Color x:Key="BorderHighlightColor">#505050</Color>

    <!--  Статусы  -->
    <Color x:Key="SuccessColor">#6ABA6A</Color>
    <Color x:Key="SuccessHoverColor">#4AA84A</Color>
    <Color x:Key="ErrorColor">#D87060</Color>
    <Color x:Key="WarningColor">#E8B840</Color>

    <!--  Редактор  -->
    <Color x:Key="EditorBackgroundColor">#161616</Color>
    <Color x:Key="EditorForegroundColor">#F0F0F0</Color>
    <Color x:Key="EditorLineNumberColor">#707070</Color>

    <!--  Терминал  -->
    <Color x:Key="TerminalBackgroundColor">#1A1A1A</Color>
    <Color x:Key="TerminalForegroundColor">#F0F0F0</Color>

    <!--  Игровое поле  -->
    <Color x:Key="MapBackgroundColor">#161616</Color>
    <Color x:Key="MapWallColor">#8A8F96</Color>
    <Color x:Key="MapPaintedCellColor">#73F2C14E</Color>
    <Color x:Key="MapPointBorderColor">#8A9A7A</Color>
    <Color x:Key="MapRequireDrawColor">#8A9A7A</Color>
    <Color x:Key="GoalColor1Color">#000000</Color>
    <Color x:Key="GoalColor2Color">#FFFFFF</Color>

    <!--  Кисти  -->
    <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}" x:Key="WindowBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource HeaderBackgroundColor}" x:Key="HeaderBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource CardBackgroundColor}" x:Key="CardBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource ElevatedBackgroundColor}" x:Key="ElevatedBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource HoverBackgroundColor}" x:Key="HoverBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource SidebarBackgroundColor}" x:Key="SidebarBackgroundBrush" />

    <SolidColorBrush Color="{DynamicResource AccentColor}" x:Key="AccentBrush" />
    <SolidColorBrush Color="{DynamicResource AccentHoverColor}" x:Key="AccentHoverBrush" />
    <SolidColorBrush Color="{DynamicResource AccentPressedColor}" x:Key="AccentPressedBrush" />
    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" x:Key="SystemAccentBrush" />

    <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" x:Key="TextPrimaryBrush" />
    <SolidColorBrush Color="{DynamicResource TextMutedColor}" x:Key="TextMutedBrush" />
    <SolidColorBrush Color="{DynamicResource TextSubtleColor}" x:Key="TextSubtleBrush" />

    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="BorderBrush" />
    <SolidColorBrush Color="{DynamicResource BorderHighlightColor}" x:Key="BorderHighlightBrush" />

    <SolidColorBrush Color="{DynamicResource SuccessColor}" x:Key="SuccessBrush" />
    <SolidColorBrush Color="{DynamicResource SuccessHoverColor}" x:Key="SuccessHoverBrush" />
    <SolidColorBrush Color="{DynamicResource ErrorColor}" x:Key="ErrorBrush" />
    <SolidColorBrush Color="{DynamicResource WarningColor}" x:Key="WarningBrush" />

    <SolidColorBrush Color="{DynamicResource EditorBackgroundColor}" x:Key="EditorBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource EditorForegroundColor}" x:Key="EditorForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource EditorLineNumberColor}" x:Key="EditorLineNumberBrush" />

    <SolidColorBrush Color="{DynamicResource TerminalBackgroundColor}" x:Key="TerminalBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource TerminalForegroundColor}" x:Key="TerminalForegroundBrush" />

    <SolidColorBrush Color="{DynamicResource MapBackgroundColor}" x:Key="MapBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource MapWallColor}" x:Key="MapWallBrush" />
    <SolidColorBrush Color="{DynamicResource MapPaintedCellColor}" x:Key="MapPaintedCellBrush" />
    <SolidColorBrush Color="{DynamicResource MapPointBorderColor}" x:Key="MapPointBorderBrush" />
    <SolidColorBrush Color="{DynamicResource MapRequireDrawColor}" x:Key="MapRequireDrawBrush" />
    <SolidColorBrush Color="{DynamicResource GoalColor1Color}" x:Key="GoalColor1Brush" />
    <SolidColorBrush Color="{DynamicResource GoalColor2Color}" x:Key="GoalColor2Brush" />

    <!--  Переопределение дефолтов FluentTheme для выпадающих списков и всплывающих меню,
          иначе они игнорируют тему приложения (чёрный фон попапов, серое выделение)  -->
    <SolidColorBrush Color="{DynamicResource CardBackgroundColor}" x:Key="MenuFlyoutPresenterBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="MenuFlyoutPresenterBorderBrush" />

    <SolidColorBrush Color="{DynamicResource CardBackgroundColor}" x:Key="FlyoutPresenterBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="FlyoutPresenterBorderBrush" />

    <SolidColorBrush Color="{DynamicResource CardBackgroundColor}" x:Key="ComboBoxDropDownBackground" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="ComboBoxDropDownBorderBrush" />

    <SolidColorBrush Color="{DynamicResource HoverBackgroundColor}" x:Key="ComboBoxItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource AccentPressedColor}" x:Key="ComboBoxItemBackgroundSelected" />
    <SolidColorBrush Color="{DynamicResource AccentHoverColor}" x:Key="ComboBoxItemBackgroundSelectedPointerOver" />
    <SolidColorBrush Color="{DynamicResource AccentPressedColor}" x:Key="ComboBoxItemBackgroundSelectedPressed" />
    <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" x:Key="ComboBoxItemForegroundSelected" />

</ResourceDictionary>

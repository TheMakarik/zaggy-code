<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  :is(Border) нужен, чтобы стиль применялся и к DialogTitleBar (наследник Border)  -->
    <Style Selector=":is(Border).header-bar">
        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!--  Единый уменьшенный размер кнопок шапки: главное окно, настройки, диалоги  -->
    <Style Selector=":is(Border).header-bar Button.icon-button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector=":is(Border).header-bar Button.icon-button materialIcons|MaterialIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <!--  Кнопка запуска в шапке меньше остальных  -->
    <Style Selector=":is(Border).header-bar Button.icon-button.run-button materialIcons|MaterialIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
</Styles>

<rxui:ReactiveUserControl
    x:Class="ZaggyCode.Avalonia.Views.UserControls.AppearanceSettingsView"
    x:DataType="vm:AppearanceSettingsViewModel"
    x:TypeArguments="vm:AppearanceSettingsViewModel"
    xmlns="https://github.com/avaloniaui"

    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:ZaggyCode.Core.Data.Enums;assembly=ZaggyCode.Core"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:records="clr-namespace:ZaggyCode.Avalonia.ViewModels.Records"
    xmlns:rxui="http://reactiveui.net"
    xmlns:userControls="clr-namespace:ZaggyCode.Avalonia.Views.UserControls"
    xmlns:vm="using:ZaggyCode.Avalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <userControls:SettingsSectionHeader
                Description="Настройки внешнего вида приложения: шрифты редактора и терминала, оформление окна и тема подсветки синтаксиса."
                IconKind="Eye"
                Title="Вид" />

            <TextBlock Classes="settings-section-title" Text="Шрифты" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="Размер шрифта редактора"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="settings-font-button"
                        Command="{Binding ChangeCodeFontSizeCommand}"
                        CommandParameter="-1"
                        IsEnabled="{Binding CanDecreaseCodeFontSize}">
                        <materialIcons:MaterialIcon Kind="ChevronDown" />
                    </Button>
                    <Button
                        Classes="settings-font-button"
                        Command="{Binding ChangeCodeFontSizeCommand}"
                        CommandParameter="1"
                        IsEnabled="{Binding CanIncreaseCodeFontSize}">
                        <materialIcons:MaterialIcon Kind="ChevronUp" />
                    </Button>
                    <TextBlock
                        Text="{Binding CodeFontSize}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="28" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="Размер шрифта терминала"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="settings-font-button"
                        Command="{Binding ChangeTerminalFontSizeCommand}"
                        CommandParameter="-1"
                        IsEnabled="{Binding CanDecreaseTerminalFontSize}">
                        <materialIcons:MaterialIcon Kind="ChevronDown" />
                    </Button>
                    <Button
                        Classes="settings-font-button"
                        Command="{Binding ChangeTerminalFontSizeCommand}"
                        CommandParameter="1"
                        IsEnabled="{Binding CanIncreaseTerminalFontSize}">
                        <materialIcons:MaterialIcon Kind="ChevronUp" />
                    </Button>
                    <TextBlock
                        Text="{Binding TerminalFontSize}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="28" />
                </StackPanel>
            </Grid>

            <TextBlock Classes="settings-section-title" Text="Окна" />

            <CheckBox Content="Использовать системную рамку окна" IsChecked="{Binding UseSystemTitleBar}" />

            <TextBlock Classes="settings-section-title" Text="Боковая панель" />

            <ItemsControl ItemsSource="{Binding SidebarPositionValues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="enums:SidebarPosition">
                        <Button
                            Classes="settings-theme-button"
                            Command="{Binding $parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SelectSidebarPositionCommand}"
                            CommandParameter="{Binding .}"
                            CornerRadius="12"
                            Margin="3,4"
                            Padding="0">
                            <Panel>
                                <Border
                                    Background="{DynamicResource HoverBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentHoverBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{converters:IsEqualConverter}">
                                            <Binding Path="." />
                                            <Binding Path="$parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SidebarPosition" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>

                                <Border CornerRadius="12" Padding="10">
                                    <StackPanel Spacing="6">
                                        <controls:SidebarPositionPreview
                                            AccentBrush="{DynamicResource AccentBrush}"
                                            ContentBrush="{DynamicResource EditorBackgroundBrush}"
                                            HeaderBrush="{DynamicResource HeaderBackgroundBrush}"
                                            Height="70"
                                            OutlineBrush="{DynamicResource BorderBrush}"
                                            Position="{Binding .}"
                                            SidebarBrush="{DynamicResource SidebarBackgroundBrush}"
                                            Width="110"
                                            WindowBackgroundBrush="{DynamicResource WindowBackgroundBrush}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <materialIcons:MaterialIcon
                                                Height="14"
                                                Kind="{Binding ., Converter={converters:SidebarPositionToIconConverter}}"
                                                Width="14" />
                                            <TextBlock Text="{Binding ., Converter={converters:SidebarPositionToTextConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="settings-section-title" Text="Тема подсветки синтаксиса" />

            <ItemsControl ItemsSource="{Binding AvailableCodeThemes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="records:CodeThemeItem">
                        <Button
                            Classes="settings-theme-button"
                            Command="{Binding $parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SelectCodeThemeCommand}"
                            CommandParameter="{Binding ThemeName}"
                            CornerRadius="20"
                            Height="30"
                            Margin="3,10"
                            Width="190">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{converters:IsNotEqualConverter}">
                                    <Binding Path="ThemeName" />
                                    <Binding Path="$parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SelectedCodeTheme" />
                                </MultiBinding>
                            </Button.IsEnabled>
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <materialIcons:MaterialIcon
                                    Kind="{Binding IconKind}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Width="24" />
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,*">
                <avaloniaEdit:TextEditor
                    Background="{DynamicResource EditorBackgroundBrush}"
                    FontSize="14"
                    Foreground="{DynamicResource EditorForegroundBrush}"
                    IsReadOnly="True"
                    LineNumbersForeground="{DynamicResource EditorLineNumberBrush}"
                    Margin="0,0,4,0"
                    Name="CSharpExampleEditor"
                    ShowLineNumbers="True" />
                <avaloniaEdit:TextEditor
                    Background="{DynamicResource EditorBackgroundBrush}"
                    FontSize="14"
                    Foreground="{DynamicResource EditorForegroundBrush}"
                    Grid.Column="1"
                    IsReadOnly="True"
                    LineNumbersForeground="{DynamicResource EditorLineNumberBrush}"
                    Margin="4,0,0,0"
                    Name="PythonExampleEditor"
                    ShowLineNumbers="True" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</rxui:ReactiveUserControl>

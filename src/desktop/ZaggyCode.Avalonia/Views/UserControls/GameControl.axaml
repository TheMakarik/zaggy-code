<rxui:ReactiveUserControl
    x:Class="ZaggyCode.Avalonia.Views.UserControls.GameControl"
    x:DataType="vm:MainWindowViewModel"
    x:TypeArguments="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:records="clr-namespace:ZaggyCode.Avalonia.ViewModels.Common.Records"
    xmlns:rxui="http://reactiveui.net"
    xmlns:vm="using:ZaggyCode.Avalonia.ViewModels.Main"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <rxui:ReactiveUserControl.Styles>
        <Style Selector="Button.map-number">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.map-number materialIcons|MaterialIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="Button.map-number.selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </rxui:ReactiveUserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto">
            <Grid
                ColumnDefinitions="Auto,Auto,*"
                Grid.Row="0"
                Margin="8,0,8,4">
                <Button
                    Background="Transparent"
                    Classes="icon-button"
                    Command="{Binding ToggleDescriptionCommand}"
                    Grid.Column="0"
                    Height="28"
                    Margin="0,0,8,0"
                    Padding="0"
                    ToolTip.Tip="{Binding DescriptionToggleToolTip}"
                    Width="28">
                    <materialIcons:MaterialIcon
                        Height="16"
                        Kind="{Binding DescriptionToggleIcon}"
                        Width="16" />
                </Button>

                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    Text="{Binding CurrentRobotGame.Name}"
                    VerticalAlignment="Center" />

                <ScrollViewer
                    Grid.Column="2"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MapNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="records:MapNumberItem">
                                <Button
                                    Classes="map-number"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectMapCommand}"
                                    CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <controls:MapControl
                BackLaggyPath="{Binding ZaggyBackLaggyPath}"
                BackPath="{Binding ZaggyBackPath}"
                CoinPath="{Binding CoinAssetPath}"
                FixedCellSize="0"
                FrontLaggyPath="{Binding ZaggyFrontLaggyPath}"
                FrontPath="{Binding ZaggyFrontPath}"
                Grid.Row="1"
                Height="300"
                LeftLaggyPath="{Binding ZaggyLeftLaggyPath}"
                LeftPath="{Binding ZaggyLeftPath}"
                Map="{Binding CurrentRobotMap}"
                MarginUnits="1,1,1,1"
                MoveStepSeconds="{Binding MoveStepSeconds}"
                PaintedBrush="{DynamicResource MapPaintedCellBrush}"
                RightLaggyPath="{Binding ZaggyRightLaggyPath}"
                RightPath="{Binding ZaggyRightPath}"
                SadPath="{Binding ZaggySadPath}"
                SadSeconds="{Binding SadSeconds}"
                SeaBrush="{DynamicResource MapBackgroundBrush}"
                x:Name="GameMap" />
        </Grid>
    </ScrollViewer>
</rxui:ReactiveUserControl>

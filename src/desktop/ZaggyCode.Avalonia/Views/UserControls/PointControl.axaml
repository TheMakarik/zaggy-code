<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="ZaggyCode.Avalonia.Views.UserControls.PointControl"
    x:DataType="robot:RobotGamePoint"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters.Common" xmlns:mapConverters="clr-namespace:ZaggyCode.Avalonia.Views.Converters.Map"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:robot="clr-namespace:ZaggyCode.Core.RobotGameCore.Model;assembly=ZaggyCode.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        <Style Selector="Rectangle.wall-segment">
            <Setter Property="Fill" Value="{DynamicResource MapWallBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border
        BorderBrush="{DynamicResource MapPointBorderBrush}"
        BorderThickness="1"
        ClipToBounds="True">
        <Border.CornerRadius>
            <MultiBinding Converter="{mapConverters:FourDoublesToCorverRadiusConverter}">
                <Binding Path="CustomBorderRadiusLeftTop" />
                <Binding Path="CustomBorderRadiusLeftBottom" />
                <Binding Path="CustomBorderRadiusRightTop" />
                <Binding Path="CustomBorderRadiusRightBottom" />
            </MultiBinding>
        </Border.CornerRadius>
        <Border.Margin>
            <MultiBinding Converter="{mapConverters:FourDoublesToThicknessConverter}">
                <Binding Path="CustomBorderMarginLeft" />
                <Binding Path="CustomBorderMarginTop" />
                <Binding Path="CustomBorderMarginRight" />
                <Binding Path="CustomBorderMarginBottom" />
            </MultiBinding>
        </Border.Margin>

        <Grid>
            <Rectangle Fill="{Binding CustomCoreBackgroundHex, Converter={converters:HexStringToBrushConverter}}" Opacity="{Binding CustomCoreOpacity, Converter={converters:NullableDoubleConverter}}" />

            <Grid>
                <Rectangle
                    Classes="wall-segment"
                    Fill="{DynamicResource MapWallBrush}"
                    IsVisible="{Binding WallType, Converter={mapConverters:WallEdgeVisibilityConverter}, ConverterParameter=Full}"
                    Opacity="{Binding CustomWallOpacity, Converter={converters:NullableDoubleConverter}}"
                    Stroke="{Binding CustomWallBorderOnPointHex, Converter={converters:HexStringToBrushConverter}}" />

                <Rectangle
                    Classes="wall-segment"
                    Fill="{DynamicResource MapWallBrush}"
                    Height="{Binding $parent[UserControl].Bounds.Height, Converter={converters:PercentOfValueConverter}, ConverterParameter=0.15}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding WallType, Converter={mapConverters:WallEdgeVisibilityConverter}, ConverterParameter=Top}"
                    Opacity="{Binding CustomWallOpacity, Converter={converters:NullableDoubleConverter}}"
                    Stroke="{Binding CustomWallBorderOnPointHex, Converter={converters:HexStringToBrushConverter}}"
                    VerticalAlignment="Top" />

                <Rectangle
                    Classes="wall-segment"
                    Fill="{DynamicResource MapWallBrush}"
                    Height="{Binding $parent[UserControl].Bounds.Height, Converter={converters:PercentOfValueConverter}, ConverterParameter=0.15}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding WallType, Converter={mapConverters:WallEdgeVisibilityConverter}, ConverterParameter=Bottom}"
                    Opacity="{Binding CustomWallOpacity, Converter={converters:NullableDoubleConverter}}"
                    Stroke="{Binding CustomWallBorderOnPointHex, Converter={converters:HexStringToBrushConverter}}"
                    VerticalAlignment="Bottom" />

                <Rectangle
                    Classes="wall-segment"
                    Fill="{DynamicResource MapWallBrush}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding WallType, Converter={mapConverters:WallEdgeVisibilityConverter}, ConverterParameter=Left}"
                    Opacity="{Binding CustomWallOpacity, Converter={converters:NullableDoubleConverter}}"
                    Stroke="{Binding CustomWallBorderOnPointHex, Converter={converters:HexStringToBrushConverter}}"
                    VerticalAlignment="Stretch"
                    Width="{Binding $parent[UserControl].Bounds.Width, Converter={converters:PercentOfValueConverter}, ConverterParameter=0.15}" />

                <Rectangle
                    Classes="wall-segment"
                    Fill="{DynamicResource MapWallBrush}"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding WallType, Converter={mapConverters:WallEdgeVisibilityConverter}, ConverterParameter=Right}"
                    Opacity="{Binding CustomWallOpacity, Converter={converters:NullableDoubleConverter}}"
                    Stroke="{Binding CustomWallBorderOnPointHex, Converter={converters:HexStringToBrushConverter}}"
                    VerticalAlignment="Stretch"
                    Width="{Binding $parent[UserControl].Bounds.Width, Converter={converters:PercentOfValueConverter}, ConverterParameter=0.15}" />
            </Grid>

            <Viewbox
                HorizontalAlignment="Center"
                IsVisible="{Binding RequireDraw}"
                Stretch="Fill"
                VerticalAlignment="Center"
                ZIndex="2">
                <Viewbox.Height>
                    <MultiBinding Converter="{mapConverters:PointRelativeSizeConverter}" ConverterParameter="0.25">
                        <Binding Path="$parent[UserControl].Bounds.Height" />
                        <Binding Path="RequireDrawMarkHeight" />
                    </MultiBinding>
                </Viewbox.Height>
                <Viewbox.Width>
                    <MultiBinding Converter="{mapConverters:PointRelativeSizeConverter}" ConverterParameter="0.25">
                        <Binding Path="$parent[UserControl].Bounds.Width" />
                        <Binding Path="RequireDrawMarkWidth" />
                    </MultiBinding>
                </Viewbox.Width>
                <Canvas Height="16" Width="16">
                    <Path
                        Data="M1,1 L15,15 M15,1 L1,15"
                        Stroke="{DynamicResource MapRequireDrawBrush}"
                        StrokeLineCap="Round">
                        <Path.StrokeThickness>
                            <MultiBinding Converter="{mapConverters:RequireDrawMarkThicknessConverter}">
                                <Binding Path="RequireDrawMarkThickness" />
                                <Binding Path="MakeRequireDrawOnGoalBold" />
                            </MultiBinding>
                        </Path.StrokeThickness>
                    </Path>
                </Canvas>
            </Viewbox>

            <Image
                HorizontalAlignment="Center"
                IsVisible="{Binding HasCoin}"
                Source="{Binding $parent[UserControl].(controls:MapAssetPaths.CoinPath), Converter={converters:ImagePathConverter}}"
                Stretch="Uniform"
                VerticalAlignment="Center"
                Width="{Binding $parent[UserControl].Bounds.Width, Converter={converters:PercentOfValueConverter}, ConverterParameter=0.6}"
                ZIndex="3" />

            <Grid
                ColumnDefinitions="*,*,*,*,*,*,*,*"
                IsVisible="{Binding IsGoal}"
                RowDefinitions="*,*,*,*,*,*,*,*"
                ZIndex="1">
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="0"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="1"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="2"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="3"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="4"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="5"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="6"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="7"
                    Grid.Row="0" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="0"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="1"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="2"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="3"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="4"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="5"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="6"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="7"
                    Grid.Row="1" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="0"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="1"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="2"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="3"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="4"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="5"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="6"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="7"
                    Grid.Row="2" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="0"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="1"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="2"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="3"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="4"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="5"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="6"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="7"
                    Grid.Row="3" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="0"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="1"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="2"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="3"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="4"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="5"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="6"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="7"
                    Grid.Row="4" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="0"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="1"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="2"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="3"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="4"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="5"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="6"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="7"
                    Grid.Row="5" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="0"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="1"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="2"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="3"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="4"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="5"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="6"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="7"
                    Grid.Row="6" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="0"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="1"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="2"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="3"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="4"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="5"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor2Brush}"
                    Grid.Column="6"
                    Grid.Row="7" />
                <Rectangle
                    Fill="{DynamicResource GoalColor1Brush}"
                    Grid.Column="7"
                    Grid.Row="7" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

<rxui:ReactiveUserControl
    mc:Ignorable="d"
    x:Class="ZaggyCode.Avalonia.Views.UserControls.ThemesSettingsView"
    x:DataType="vm:AppearanceSettingsViewModel"
    x:TypeArguments="vm:AppearanceSettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:ZaggyCode.Avalonia.Views.Controls"
    xmlns:converters="clr-namespace:ZaggyCode.Avalonia.Views.Converters.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:records="clr-namespace:ZaggyCode.Avalonia.ViewModels.Common.Records"
    xmlns:rxui="http://reactiveui.net"
    xmlns:themeConverters="clr-namespace:ZaggyCode.Avalonia.Views.Converters.Themes"
    xmlns:userControls="clr-namespace:ZaggyCode.Avalonia.Views.UserControls"
    xmlns:vm="using:ZaggyCode.Avalonia.ViewModels.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            Margin="20"
            Spacing="16"
            x:Name="RootPanel">
            <StackPanel.ContextMenu>
                <ContextMenu x:Name="RootContextMenu">
                    <MenuItem
                        Command="{Binding AddNewThemeCommand}"
                        Header="Создать новую тему"
                        Icon="{materialIcons:MaterialIconExt Kind=Plus}" />
                </ContextMenu>
            </StackPanel.ContextMenu>

            <userControls:SettingsSectionHeader
                Description="Оформление приложения: цвет фона, поверхностей, рамок и подсветки."
                IconKind="Palette"
                Title="Темы" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <materialIcons:MaterialIcon
                    Foreground="{Binding #ThemeSearchBox.BorderBrush}"
                    Kind="Search"
                    VerticalAlignment="Center" />
                <TextBox
                    Background="{DynamicResource SearchBackgroundBrush}"
                    CornerRadius="8"
                    Grid.Column="1"
                    Name="ThemeSearchBox"
                    PlaceholderText="Поиск тем…"
                    Text="{Binding ThemeSearchText, Mode=TwoWay}" />
                <Grid.Styles>
                    <Style Selector="TextBox">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    </Style>
                    <Style Selector="TextBox:pointerover">
                        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TextBox:focus">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Style>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Style>
                </Grid.Styles>
            </Grid>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock Text="При создании темы:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ThemeCreationBehaviorValues}" SelectedItem="{Binding ThemeCreationBehavior}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="{Binding Converter={themeConverters:ThemeCreationBehaviorToIconConverter}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Converter={themeConverters:ThemeCreationBehaviorToTextConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                IsVisible="{Binding IsLoadingThemes}"
                Orientation="Horizontal"
                Spacing="8">
                <controls:LoadingDotsControl MaxDotCount="{Binding LoadingDotsMaxCount}" />
            </StackPanel>

            <ItemsControl IsVisible="{Binding IsLoadingThemes, Converter={converters:InverseBooleanConverter}}" ItemsSource="{Binding FilteredAppThemes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="records:ThemeMetadataItem">
                        <Button
                            Classes="app-theme-button"
                            Command="{Binding $parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SelectAppThemeCommand}"
                            CommandParameter="{Binding Name}"
                            CornerRadius="12"
                            Margin="3,10"
                            Padding="0"
                            PointerEntered="OnThemeCardPointerEntered"
                            PointerExited="OnThemeCardPointerExited">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding Name}"
                                        Header="Выбрать"
                                        Icon="{materialIcons:MaterialIconExt Kind=Check}" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Удалить"
                                        Icon="{materialIcons:MaterialIconExt Kind=TrashCan}"
                                        IsEnabled="{Binding IsSystemTheme, Converter={converters:InverseBooleanConverter}}" />
                                    <MenuItem
                                        Command="{Binding EditCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Редактировать"
                                        Icon="{materialIcons:MaterialIconExt Kind=Pencil}"
                                        IsEnabled="{Binding IsSystemTheme, Converter={converters:InverseBooleanConverter}}" />
                                    <MenuItem
                                        Command="{Binding ShowFileCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Показать файл"
                                        Icon="{materialIcons:MaterialIconExt Kind=FileEye}" />
                                    <MenuItem
                                        Command="{Binding CopyFileCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Копировать файл"
                                        Icon="{materialIcons:MaterialIconExt Kind=ContentCopy}" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding CopyCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Копировать"
                                        Icon="{materialIcons:MaterialIconExt Kind=ContentDuplicate}" />
                                    <MenuItem
                                        Command="{Binding CreateNewCommand}"
                                        Header="Создать новую тему"
                                        Icon="{materialIcons:MaterialIconExt Kind=Plus}" />
                                    <MenuItem IsEnabled="False" IsVisible="{Binding IsSystemTheme}">
                                        <MenuItem.Header>
                                            <StackPanel HorizontalAlignment="Center" Spacing="0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="Системная тема,"
                                                    TextAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="редактирование не поддерживается"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Panel>
                                <!--  Подложка выбранной темы: держит hover-фон без наведения  -->
                                <Border
                                    Background="{DynamicResource HoverBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentHoverBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{converters:IsEqualConverter}">
                                            <Binding Path="Name" />
                                            <Binding Path="$parent[ItemsControl].((vm:AppearanceSettingsViewModel)DataContext).SelectedAppTheme" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                </Border>

                                <Border CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="8">
                                        <controls:ThemeSchemePreview
                                            ContentForegroundBrush="{Binding Foreground}"
                                            EditorBrush="{Binding EditorBackground}"
                                            Height="90"
                                            OutlineBrush="{Binding Border}"
                                            SidebarBrush="{Binding Sidebar}"
                                            TerminalBrush="{Binding TerminalBackground}"
                                            TitleBarBrush="{Binding Primary}"
                                            Width="150"
                                            WindowBackgroundBrush="{Binding Background}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                </Border>

                                <Popup
                                    HorizontalOffset="20"
                                    IsLightDismissEnabled="False"
                                    Placement="Top">
                                    <Border
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        BoxShadow="0 4 16 0 #22000000"
                                        CornerRadius="8"
                                        Padding="12"
                                        Width="240">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextMutedColor}"
                                                Text="{Binding Author, StringFormat='Автор: {0}'}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextMutedColor}"
                                                Text="{Binding Version, StringFormat='Версия: {0}'}" />
                                            <TextBlock
                                                FontSize="12"
                                                LineHeight="17"
                                                Margin="0,4,0,0"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</rxui:ReactiveUserControl>

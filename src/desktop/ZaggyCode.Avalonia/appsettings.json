{
  "StorageOptions": {
    "GameCodeDataPath": "%ZAGGY_CONFIG%/game-code",
    "DataFilePath": "%ZAGGY_CONFIG%/data.json",
    "WaitUserDataUpdateSeconds": 3,
    "PythonSettingsPath": "%ZAGGY_CONFIG%/python-settings.json",
    "CSharpSettingsPath": "%ZAGGY_CONFIG%/csharp-settings.json",
    "ThemeSettingsPath": "%ZAGGY_CONFIG%/theme-settings.json"
  },

  "TempOptions": {
    "TempDirectoryPath": "%ZAGGY_TEMP%/zaggy",
    "TempToCompress": "%ZAGGY_TEMP%/zaggy/to-compress",
    "TempFromCompress": "%ZAGGY_TEMP%/zaggy/from-compress"
  },

  "ThemeOptions": {
    "ThemeExtensions": ".zct",
    "ThemeFileName": "theme.xml",
    "SystemThemesFolder": "%ZAGGY_APP%/Themes",
    "ExternThemesFolder": "%ZAGGY_DATA%/themes"
  },

  "MetadataOptions": {
    "MetadataFile": "meta.json"
  },

  "ThemeColorDisplayNameOptions": {
    "Names": {
      "WindowBackgroundColor": "Фон окна",

      "HoverBackgroundColor": "Фон под курсором",
      "SidebarBackgroundColor": "Фон боковой панели",
      "AccentColor": "Акцент",
      "AccentHoverColor": "Акцент (наведение)",
      "AccentPressedColor": "Акцент (нажатие)",
      "SystemAccentColor": "Системный акцент",
      "TextPrimaryColor": "Основной текст",
      "TextMutedColor": "Приглушённый текст",
      "TextSubtleColor": "Второстепенный текст",
      "BorderColor": "Рамка",
      "BorderHighlightColor": "Рамка (акцент)",
      "SuccessColor": "Успех",
      "SuccessHoverColor": "Успех (наведение)",
      "ErrorColor": "Ошибка",
      "WarningColor": "Предупреждение",
      "EditorBackgroundColor": "Фон редактора",
      "EditorForegroundColor": "Текст редактора",
      "EditorLineNumberColor": "Номера строк редактора",
      "TerminalBackgroundColor": "Фон терминала",
      "TerminalForegroundColor": "Текст терминала",
      "MapBackgroundColor": "Фон игрового поля",
      "MapWallColor": "Стены карты",
      "MapPaintedCellColor": "Закрашенная клетка",
      "MapPointBorderColor": "Рамка точки карты",
      "MapRequireDrawColor": "Крестик require-draw",
      "GoalColor1": "Финиш, цвет 1",
      "GoalColor2": "Финиш, цвет 2"
    }
  },

  "AboutAvaloniaOptions": {
    "LogoPath": "%ZAGGY_APP%/Assets/avalonia-logo.png",
    "Title": "AvaloniaUI",
    "Description": "Кроссплатформенный UI-фреймворк для .NET: один XAML-код и одна кодовая база для Windows, macOS, Linux, iOS, Android и WebAssembly.",
    "WebsiteText": "avaloniaui.net",
    "WebsiteUrl": "https://avaloniaui.net",
    "GitHubText": "github.com/AvaloniaUI/Avalonia",
    "GitHubUrl": "https://github.com/AvaloniaUI/Avalonia"
  },

  "LoggingCompressOptions": {
    "RetentionDays": 3,
    "LogsDirectoryPath": "%ZAGGY_STATE%/logs",
    "ArchivesDirectoryPath": "%ZAGGY_STATE%/archives"
  },

  "ZaggyAssetsOptions": {
    "IconPath": "%ZAGGY_APP%/Assets/logo.ico",
    "LogoPath": "%ZAGGY_APP%/Assets/logo.svg",
    "EmotionQuestion": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-question.svg",
    "EmotionAngry": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-angry.svg",
    "EmotionLike": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-like.svg",
    "EmotionLove": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-love.svg",
    "EmotionSad": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-sad.svg",
    "EmotionShock": "%ZAGGY_APP%/Assets/Zaggy/zaggy-emotion-shock.svg",
    "ZaggySideFront": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-front.svg",
    "ZaggySideBack": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-back.svg",
    "ZaggySideLeft": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-left.svg",
    "ZaggySideRight": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-right.svg",
    "ZaggySideFrontLaggy": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-front-laggy.svg",
    "ZaggySideBackLaggy": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-back-laggy.svg",
    "ZaggySideLeftLaggy": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-left-laggy.svg",
    "ZaggySideRightLaggy": "%ZAGGY_APP%/Assets/Zaggy/zaggy-side-right-laggy.svg"
  },

  "MapAssetsOptions": {
    "Coin": "%ZAGGY_APP%/Assets/Map/coin.svg"
  },

  "MapAnimationOptions": {
    "MoveStepSeconds": 0.22,
    "SadSeconds": 0.4
  },
  
  "PythonScriptsOptions": {
    "PrepareModules": "%ZAGGY_APP%/Languages/Python/prepare_modules.py",
    "RedirectIoPath": "%ZAGGY_APP%/Languages/Python/redirect_io.py",
    "RobotPath": "%ZAGGY_APP%/Languages/Python/robot.py",
    "StandardLibraryPath": "%ZAGGY_APP%/Languages/Python/Lib"
  },

  "PythonDefaultSettingsOptions": {
    "Settings": {
      "UseEntryFunction": false,
      "EntryFunctionName": "main",
      "DetailedExceptions": true,
      "SupressIo": false,
      "PythonPath": "%ZAGGY_PYTHON%"
    }
  },

  "CSharpDefaultSettingsOptions": {
    "Settings": {
      "UseTopLevelStatements": true,
      "EnableImplicitUsings": true,
      "BlockIo": false
    }
  },

  "PythonValidationOptions": {
    "ForbiddenCharacters": ["@", "#", "$", "%", "&", "*", "!", "?", "<", ">", "/", "\\", "|", "+", "-", "=", "^", "~", "`", "{", "}", "[", "]", ":", ";", "\"", "'", ","],
    "GlobalFunctions": ["print", "input", "exec", "eval", "compile", "open", "globals", "locals", "vars", "dir", "help", "type", "isinstance", "issubclass", "len", "range", "enumerate", "zip", "map", "filter", "sum", "min", "max", "sorted", "reversed", "iter", "next", "abs", "round", "pow", "divmod", "bin", "oct", "hex", "chr", "ord", "str", "int", "float", "bool", "list", "tuple", "dict", "set", "frozenset", "object", "property", "staticmethod", "classmethod", "super", "hasattr", "getattr", "setattr", "delattr", "callable", "hash", "id", "repr", "ascii", "format", "bytes", "bytearray", "memoryview", "slice", "complex", "all", "any", "sorted", "breakpoint", "__import__"],
    "SkipFiles": ["__init__.py", "main.py"]
  },

  "DefaultUser": {
    "User": {
      "UseSystemTitleBar": false,
      "ShowSidebar": true,
      "SidebarPosition": "Left",
      "CodeFontSize": 14,
      "TerminalFontSize": 18,
      "CodeTheme": "VisualStudioDark",
      "LastLanguage": "Python",
      "LastGamePath": null,
      "LastSpeed": "X2"
    }
  },

  "DefaultThemeSettings": {
    "Settings": {
      "CurrentTheme": "Primus",
      "OnCreateBehavior": "OpenEditorAndApply"
    }
  },

  "CodeExamplePathOptions": {
    "CSharpExamplePath": "%ZAGGY_APP%/Assets/CodeExamples/csharp_example.cs",
    "PythonExamplePath": "%ZAGGY_APP%/Assets/CodeExamples/python_example.py"
  },

  "PopupOptions": {
    "PopupDisplaySeconds": 1.5,
    "PopupFadeOutSeconds": 0.5
  },

  "LoadingOptions": {
    "LoadingDotsMaxCount": 3
  },

  "FontSizeOptions": {
    "MaxFontSize": 30,
    "MinFontSize": 10
  },

  "CodeThemeDisplayNameOptions": {
    "VisualStudioDark": "Visual Studio Dark",
    "VisualStudioLight": "Visual Studio Light",
    "Monokai": "Monokai",
    "Dracula": "Dracula",
    "SolarizedDark": "Solarized Dark",
    "SolarizedLight": "Solarized Light",
    "AtomOneDark": "Atom One Dark",
    "AtomOneLight": "Atom One Light",
    "Dark": "Dark",
    "Light": "Light",
    "DarkPlus": "Dark Plus",
    "LightPlus": "Light Plus",
    "Abbys": "Abyss",
    "DimmedMonokai": "Dimmed Monokai",
    "KimbieDark": "Kimbie Dark",
    "QuietLight": "Quiet Light",
    "Red": "Red",
    "TomorrowNightBlue": "Tomorrow Night Blue",
    "HighContrastLight": "High Contrast Light",
    "HighContrastDark": "High Contrast Dark"
  },

  "CodeThemeIconOptions": {
    "VisualStudioDark": "MicrosoftVisualStudio",
    "VisualStudioLight": "MicrosoftVisualStudio",
    "Monokai": "FruitCitrus",
    "Dracula": "Blood",
    "SolarizedDark": "WhiteBalanceSunny",
    "SolarizedLight": "WhiteBalanceSunny",
    "AtomOneDark": "Atom",
    "AtomOneLight": "Atom",
    "Dark": "WeatherNight",
    "Light": "WhiteBalanceSunny",
    "DarkPlus": "Plus",
    "LightPlus": "Plus",
    "Abbys": "Water",
    "DimmedMonokai": "Brightness2",
    "KimbieDark": "Coffee",
    "QuietLight": "VolumeMute",
    "Red": "Palette",
    "TomorrowNightBlue": "MoonWaningCrescent",
    "HighContrastLight": "ContrastCircle",
    "HighContrastDark": "ContrastCircle"
  },

  "SpeedMillisecondsOptions": {
    "X1": 1000,
    "X2": 500,
    "X5": 200,
    "X10": 100,
    "X20": 50,
    "SleepChunk": 50
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Settings.Configuration"
    ],

    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug"
      }
    },

    "Enrich": [
      "WithThreadId"
    ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm}] [{Level}] [Thread:{ThreadId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%ZAGGY_STATE%/logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [Thread:{ThreadId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}